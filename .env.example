# ═══════════════════════════════════════════════════════════════
# Cinema System - Environment Variables Template
# ═══════════════════════════════════════════════════════════════
# Cách sử dụng:
#   1. Copy file này thành .env:  cp .env.example .env
#   2. Điền các giá trị thực tế vào file .env
#   3. KHÔNG ĐƯỢC commit file .env lên Git!
#
# Ký hiệu:
#   🔒 = BẮT BUỘC thay đổi (secret/credential)
#   ⚙️ = Tuỳ chỉnh theo môi trường
#   📌 = Giữ nguyên giá trị mặc định cũng được
# ═══════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────
# General Configuration
# ─────────────────────────────────────────────────────────────

# 📌 Múi giờ hệ thống (JVM, Docker, DB đều dùng chung)
APP_TIMEZONE=Asia/Ho_Chi_Minh


# ─────────────────────────────────────────────────────────────
# Database Configuration (Local Development)
# ─────────────────────────────────────────────────────────────

# ⚙️ Host của PostgreSQL (localhost khi chạy local, cinema-db khi Docker)
DB_HOST=localhost

# 🔒 Thông tin đăng nhập PostgreSQL — thay bằng credential thực tế
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# ⚙️ JDBC URLs — thay host/port nếu cần
DB_IAM_URL=jdbc:postgresql://localhost:5432/cinema_db
DB_CATALOG_URL=jdbc:postgresql://localhost:5432/cinema_db
DB_FACILITY_URL=jdbc:postgresql://localhost:5432/cinema_db
DB_SCHEDULING_URL=jdbc:postgresql://localhost:5432/cinema_db
DB_BOOKING_URL=jdbc:postgresql://localhost:5432/cinema_db

# ⚙️ Port PostgreSQL (Docker expose)
DB_PORT=5432


# ─────────────────────────────────────────────────────────────
# Redis Configuration
# ─────────────────────────────────────────────────────────────

# ⚙️ Host Redis (localhost khi local, cinema-redis khi Docker)
REDIS_HOST=localhost

# 📌 Port Redis
REDIS_PORT=6379


# ─────────────────────────────────────────────────────────────
# Keycloak Configuration
# ─────────────────────────────────────────────────────────────

# 🔒 Admin credentials cho Keycloak bootstrap
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=your_keycloak_admin_password_here

# ⚙️ Issuer URI — realm phải khớp với cấu hình Keycloak
KEYCLOAK_ISSUER_URI=http://localhost:8089/realms/cinema-realm

# 🔒 Client secret từ Keycloak realm → Clients → cinema-backend → Credentials
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret_here

# 📌 Client ID đã đăng ký trong Keycloak
KEYCLOAK_CLIENT_ID=cinema-backend

# ⚙️ URL nội bộ Keycloak (dùng trong Docker network)
KEYCLOAK_ISSUER_URI_INTERNAL=http://cinema-keycloak:8080/realms/cinema-realm
KEYCLOAK_URL=http://cinema-keycloak:8089


# ─────────────────────────────────────────────────────────────
# Spring Boot / JPA Configuration
# ─────────────────────────────────────────────────────────────

# ⚙️ DDL auto strategy: update (dev), validate (production)
JPA_DDL_AUTO=update

# 📌 Hiển thị câu SQL trong console
JPA_SHOW_SQL=false


# ─────────────────────────────────────────────────────────────
# Security & JWT Configuration
# ─────────────────────────────────────────────────────────────

# ⚙️ CORS origins — thêm domain production nếu deploy
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4000

# 📌 Rate limit cho sync requests
RATE_LIMIT_SYNC=10

# 🔒 JWT signing secret — PHẢI thay bằng chuỗi random dài, bảo mật
#    Gợi ý tạo: openssl rand -base64 64
APP_SECURITY_JWT_SECRET=your_jwt_secret_here_change_this_immediately

# ⚙️ JWT expiration (milliseconds) — mặc định 30 phút
JWT_EXPIRATION_MS=1800000

# 🔒 API Key bảo vệ public endpoints (Frontend gửi qua header X-API-Key)
API_KEY=your_api_key_here

# 🔒 Internal API Key (giao tiếp giữa microservices qua header X-Internal-Api-Key)
APP_SECURITY_INTERNAL_API_KEY=your_internal_api_key_here


# ─────────────────────────────────────────────────────────────
# AES Encryption (Frontend ↔ Backend body encryption)
# ─────────────────────────────────────────────────────────────

# 🔒 AES-256 key — PHẢI đúng 32 ký tự và khớp giữa Frontend & Backend
CRYPTO_KEY=YourAes256KeyExactly32Chars!!


# ─────────────────────────────────────────────────────────────
# Logging Configuration
# ─────────────────────────────────────────────────────────────

# 📌 Log level: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=INFO


# ─────────────────────────────────────────────────────────────
# VNPay Payment Gateway
# ─────────────────────────────────────────────────────────────

# 🔒 Mã terminal từ VNPay merchant dashboard
VNPAY_TMN_CODE=your_vnpay_tmn_code

# 🔒 Hash secret từ VNPay merchant dashboard
VNPAY_HASH_SECRET=your_vnpay_hash_secret

# ⚙️ VNPay gateway URL (sandbox cho dev, thay bằng production URL khi go-live)
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# ⚙️ URL callback sau thanh toán (trỏ về booking-service qua gateway)
VNPAY_RETURN_URL=http://localhost:8080/api/v1/vnpay/return

# ⚙️ URL frontend hiển thị kết quả thanh toán
VNPAY_FRONTEND_URL=http://localhost:4200/booking/result


# ─────────────────────────────────────────────────────────────
# Frontend Configuration
# ─────────────────────────────────────────────────────────────

# ⚙️ Base URL API mà frontend gọi tới
FRONTEND_API_URL=http://localhost:8080/api/v1

# ⚙️ URL frontend (dùng cho redirect, CORS, email links)
FRONTEND_URL=http://localhost:4200


# ─────────────────────────────────────────────────────────────
# Kafka Configuration
# ─────────────────────────────────────────────────────────────

# ⚙️ Kafka bootstrap servers (localhost khi local, kafka:29092 khi Docker)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092


# ─────────────────────────────────────────────────────────────
# Camunda BPM Configuration
# ─────────────────────────────────────────────────────────────

# 🔒 Password cho Camunda admin webapps
CAMUNDA_ADMIN_PASSWORD=your_camunda_admin_password


# ─────────────────────────────────────────────────────────────
# Microservice Internal URLs (Docker network)
# ─────────────────────────────────────────────────────────────

# 📌 Các URL này dùng cho giao tiếp nội bộ giữa services trong Docker
IAM_SERVICE_URL=http://auth-service:8081
CATALOG_SERVICE_URL=http://management-service:8086
FACILITY_SERVICE_URL=http://management-service:8086
SCHEDULING_SERVICE_URL=http://management-service:8086
BOOKING_SERVICE_URL=http://booking-service:8085
ADMIN_SERVICE_URL=http://management-service:8086
GATEWAY_URL=http://cinema-gateway:8080


# ─────────────────────────────────────────────────────────────
# Docker Internal Host Names
# ─────────────────────────────────────────────────────────────

# 📌 Service names trong Docker Compose network
DOCKER_DB_HOST=cinema-db
DOCKER_REDIS_HOST=cinema-redis
DOCKER_KEYCLOAK_HOST=cinema-keycloak


# ─────────────────────────────────────────────────────────────
# Email / SMTP Configuration
# ─────────────────────────────────────────────────────────────
# Chọn MỘT trong ba cấu hình bên dưới, comment/uncomment tương ứng.

# ─── MAILHOG (Local Testing — không cần username/password) ───
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_FROM=noreply@cinema.local

# ─── MAILTRAP (Staging/Cloud Testing) ───
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=your_mailtrap_username
# MAIL_PASSWORD=your_mailtrap_password
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS_ENABLE=true
# MAIL_FROM=noreply@cinema.local

# ─── GMAIL (Production) ───
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS_ENABLE=true
# MAIL_FROM=your-email@gmail.com


# ─────────────────────────────────────────────────────────────
# Docker Hub (Production Deployment)
# ─────────────────────────────────────────────────────────────

# ⚙️ Docker Hub username — dùng trong docker-compose.production.yml
# DOCKERHUB_USERNAME=your_dockerhub_username
