<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Booking" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="movie-ticket-booking-process" name="Quy trình đặt vé xem phim" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Khách bắt đầu đặt vé">
      <bpmn:outgoing>Flow_StartToLock</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_LockSeats" name="Giữ ghế &#38; Tạo đơn PENDING" camunda:delegateExpression="${lockSeatsDelegate}">
      <bpmn:incoming>Flow_StartToLock</bpmn:incoming>
      <bpmn:outgoing>Flow_LockToGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_StartToLock" sourceRef="StartEvent_1" targetRef="Activity_LockSeats" />
    <bpmn:exclusiveGateway id="Gateway_PaymentMethod" name="Phương thức thanh toán?">
      <bpmn:incoming>Flow_LockToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentOnline</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentCounter</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_LockToGateway" sourceRef="Activity_LockSeats" targetRef="Gateway_PaymentMethod" />
    <bpmn:serviceTask id="Activity_GeneratePaymentUrl" name="Sinh URL thanh toán VNPay" camunda:delegateExpression="${generatePaymentUrlDelegate}">
      <bpmn:incoming>Flow_PaymentOnline</bpmn:incoming>
      <bpmn:outgoing>Flow_GenerateToWait</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_PaymentOnline" name="Online (VNPay)" sourceRef="Gateway_PaymentMethod" targetRef="Activity_GeneratePaymentUrl">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentMethod == 'ONLINE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:receiveTask id="Activity_WaitForVnPay" name="Chờ callback VNPay" messageRef="Message_0pklel4">
      <bpmn:incoming>Flow_GenerateToWait</bpmn:incoming>
      <bpmn:outgoing>Flow_VnPaySuccess</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sequenceFlow id="Flow_GenerateToWait" sourceRef="Activity_GeneratePaymentUrl" targetRef="Activity_WaitForVnPay" />
    <bpmn:sequenceFlow id="Flow_VnPaySuccess" sourceRef="Activity_WaitForVnPay" targetRef="Activity_ConfirmBooking" />
    <bpmn:boundaryEvent id="Event_VnPayTimer" name="5 phút" attachedToRef="Activity_WaitForVnPay">
      <bpmn:outgoing>Flow_VnPayTimeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_VnPay">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_VnPayTimeout" sourceRef="Event_VnPayTimer" targetRef="Activity_CancelBooking" />
    <bpmn:userTask id="Activity_CounterPayment" name="Nhân viên quầy thu tiền &#38; Xác nhận" camunda:candidateGroups="ROLE_STAFF">
      <bpmn:incoming>Flow_PaymentCounter</bpmn:incoming>
      <bpmn:outgoing>Flow_CounterToGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_PaymentCounter" name="Tại quầy" sourceRef="Gateway_PaymentMethod" targetRef="Activity_CounterPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentMethod == 'COUNTER'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_CounterStatus" name="Đã thanh toán tại quầy?">
      <bpmn:incoming>Flow_CounterToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_CounterPaidTrue</bpmn:outgoing>
      <bpmn:outgoing>Flow_CounterPaidFalse</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_CounterToGateway" sourceRef="Activity_CounterPayment" targetRef="Gateway_CounterStatus" />
    <bpmn:sequenceFlow id="Flow_CounterPaidTrue" name="Đã thu tiền" sourceRef="Gateway_CounterStatus" targetRef="Activity_ConfirmBooking">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${counterPaid == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CounterPaidFalse" name="Hủy/Không thu tiền" sourceRef="Gateway_CounterStatus" targetRef="Activity_CancelBooking">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${counterPaid == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:boundaryEvent id="Event_CounterTimer" name="15 phút" attachedToRef="Activity_CounterPayment">
      <bpmn:outgoing>Flow_CounterTimeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Counter">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_CounterTimeout" sourceRef="Event_CounterTimer" targetRef="Activity_CancelBooking" />
    <bpmn:serviceTask id="Activity_ConfirmBooking" name="Xác nhận đơn CONFIRMED" camunda:delegateExpression="${confirmBookingDelegate}">
      <bpmn:incoming>Flow_VnPaySuccess</bpmn:incoming>
      <bpmn:incoming>Flow_CounterPaidTrue</bpmn:incoming>
      <bpmn:outgoing>Flow_ConfirmToPublish</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ConfirmToPublish" sourceRef="Activity_ConfirmBooking" targetRef="Activity_PublishEvent" />
    <bpmn:serviceTask id="Activity_PublishEvent" name="Phát sự kiện Kafka &#38; Gửi mail" camunda:delegateExpression="${publishBookingConfirmedDelegate}">
      <bpmn:incoming>Flow_ConfirmToPublish</bpmn:incoming>
      <bpmn:outgoing>Flow_PublishToSuccess</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_Success" name="Đặt vé thành công">
      <bpmn:incoming>Flow_PublishToSuccess</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_PublishToSuccess" sourceRef="Activity_PublishEvent" targetRef="Event_Success" />
    <bpmn:serviceTask id="Activity_CancelBooking" name="Hủy đơn &#38; Giải phóng ghế" camunda:delegateExpression="${cancelBookingDelegate}">
      <bpmn:incoming>Flow_VnPayTimeout</bpmn:incoming>
      <bpmn:incoming>Flow_CounterPaidFalse</bpmn:incoming>
      <bpmn:incoming>Flow_CounterTimeout</bpmn:incoming>
      <bpmn:outgoing>Flow_CancelToExpired</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_Expired" name="Hủy đơn do quá hạn hoặc hủy">
      <bpmn:incoming>Flow_CancelToExpired</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_CancelToExpired" sourceRef="Activity_CancelBooking" targetRef="Event_Expired" />
    <bpmn:startEvent id="Event_1lo815r">
      <bpmn:outgoing>Flow_0hjfan4</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0hjfan4" sourceRef="Event_1lo815r" targetRef="Activity_1lh6yoc" />
    <bpmn:sequenceFlow id="Flow_02id9bs" sourceRef="Activity_1lh6yoc" targetRef="Activity_0oyh8a7" />
    <bpmn:endEvent id="Event_1rqh5il">
      <bpmn:incoming>Flow_1deewqx</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1deewqx" sourceRef="Activity_0oyh8a7" targetRef="Event_1rqh5il" />
    <bpmn:userTask id="Activity_1lh6yoc">
      <bpmn:incoming>Flow_0hjfan4</bpmn:incoming>
      <bpmn:outgoing>Flow_02id9bs</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_0oyh8a7">
      <bpmn:incoming>Flow_02id9bs</bpmn:incoming>
      <bpmn:outgoing>Flow_1deewqx</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
  <bpmn:message id="Message_0pklel4" name="PaymentReceivedMessage" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="movie-ticket-booking-process">
