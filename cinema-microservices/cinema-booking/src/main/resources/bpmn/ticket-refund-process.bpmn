<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Refund" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="ticket-refund-process" name="Quy trình duyệt hoàn tiền vé" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Refund" name="Khách yêu cầu hoàn vé">
      <bpmn:outgoing>Flow_StartToCheck</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_CheckEligibility" name="Tự động kiểm tra điều kiện" camunda:delegateExpression="${checkRefundEligibilityDelegate}">
      <bpmn:incoming>Flow_StartToCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckToGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_StartToCheck" sourceRef="StartEvent_Refund" targetRef="Activity_CheckEligibility" />
    <bpmn:exclusiveGateway id="Gateway_AutoEligibility" name="Đủ điều kiện tự động?">
      <bpmn:incoming>Flow_CheckToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoEligibleTrue</bpmn:outgoing>
      <bpmn:outgoing>Flow_AutoEligibleFalse</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_CheckToGateway" sourceRef="Activity_CheckEligibility" targetRef="Gateway_AutoEligibility" />
    <bpmn:sequenceFlow id="Flow_AutoEligibleTrue" name="Có" sourceRef="Gateway_AutoEligibility" targetRef="Activity_RefundMoney">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isAutoEligible == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_ApproveRefund" name="Phê duyệt hoàn vé thủ công" camunda:candidateGroups="ROLE_ADMIN">
      <bpmn:incoming>Flow_AutoEligibleFalse</bpmn:incoming>
      <bpmn:outgoing>Flow_UserToGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_AutoEligibleFalse" name="Không" sourceRef="Gateway_AutoEligibility" targetRef="Activity_ApproveRefund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isAutoEligible == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_AdminApproval" name="Admin duyệt đồng ý?">
      <bpmn:incoming>Flow_UserToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_AdminApprovedTrue</bpmn:outgoing>
      <bpmn:outgoing>Flow_AdminApprovedFalse</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_UserToGateway" sourceRef="Activity_ApproveRefund" targetRef="Gateway_AdminApproval" />
    <bpmn:serviceTask id="Activity_RefundMoney" name="Hoàn tiền VNPay" camunda:delegateExpression="${refundMoneyDelegate}">
      <bpmn:incoming>Flow_AutoEligibleTrue</bpmn:incoming>
      <bpmn:incoming>Flow_AdminApprovedTrue</bpmn:incoming>
      <bpmn:outgoing>Flow_RefundToSuccess</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AdminApprovedTrue" name="Duyệt đồng ý" sourceRef="Gateway_AdminApproval" targetRef="Activity_RefundMoney">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${adminApproval == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_RejectRefund" name="Gửi email từ chối hoàn tiền" camunda:delegateExpression="${rejectRefundDelegate}">
      <bpmn:incoming>Flow_AdminApprovedFalse</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectToFail</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AdminApprovedFalse" name="Từ chối" sourceRef="Gateway_AdminApproval" targetRef="Activity_RejectRefund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${adminApproval == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="EndEvent_RefundSuccess" name="Hoàn tiền thành công">
      <bpmn:incoming>Flow_RefundToSuccess</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_RefundToSuccess" sourceRef="Activity_RefundMoney" targetRef="EndEvent_RefundSuccess" />
    <bpmn:endEvent id="EndEvent_RefundRejected" name="Từ chối hoàn tiền">
      <bpmn:incoming>Flow_RejectToFail</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_RejectToFail" sourceRef="Activity_RejectRefund" targetRef="EndEvent_RefundRejected" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Refund">
    <bpmndi:BPMNPlane id="BPMNPlane_Refund" bpmnElement="ticket-refund-process">
      <bpmndi:BPMNShape id="StartEvent_Refund_di" bpmnElement="StartEvent_Refund">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="131" y="145" width="79" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_CheckEligibility_di" bpmnElement="Activity_CheckEligibility">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AutoEligibility_di" bpmnElement="Gateway_AutoEligibility" isMarkerVisible="true">
        <dc:Bounds x="395" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="382" y="65" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ApproveRefund_di" bpmnElement="Activity_ApproveRefund">
        <dc:Bounds x="500" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AdminApproval_di" bpmnElement="Gateway_AdminApproval" isMarkerVisible="true">
        <dc:Bounds x="655" y="205" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="638" y="175" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_RefundMoney_di" bpmnElement="Activity_RefundMoney">
        <dc:Bounds x="780" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_RejectRefund_di" bpmnElement="Activity_RejectRefund">
        <dc:Bounds x="780" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_RefundSuccess_di" bpmnElement="EndEvent_RefundSuccess">
        <dc:Bounds x="942" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="921" y="145" width="79" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_RefundRejected_di" bpmnElement="EndEvent_RefundRejected">
        <dc:Bounds x="942" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="918" y="365" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_StartToCheck_di" bpmnElement="Flow_StartToCheck">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CheckToGateway_di" bpmnElement="Flow_CheckToGateway">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="395" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AutoEligibleTrue_di" bpmnElement="Flow_AutoEligibleTrue">
        <di:waypoint x="445" y="120" />
        <di:waypoint x="780" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="462" y="102" width="16" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AutoEligibleFalse_di" bpmnElement="Flow_AutoEligibleFalse">
        <di:waypoint x="420" y="145" />
        <di:waypoint x="420" y="230" />
        <di:waypoint x="500" y="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="429" y="153" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_UserToGateway_di" bpmnElement="Flow_UserToGateway">
        <di:waypoint x="600" y="230" />
        <di:waypoint x="655" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AdminApprovedTrue_di" bpmnElement="Flow_AdminApprovedTrue">
        <di:waypoint x="705" y="230" />
        <di:waypoint x="740" y="230" />
        <di:waypoint x="740" y="140" />
        <di:waypoint x="780" y="140" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="696" y="238" width="67" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AdminApprovedFalse_di" bpmnElement="Flow_AdminApprovedFalse">
        <di:waypoint x="680" y="255" />
        <di:waypoint x="680" y="340" />
        <di:waypoint x="780" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="692" y="273" width="37" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RefundToSuccess_di" bpmnElement="Flow_RefundToSuccess">
        <di:waypoint x="880" y="120" />
        <di:waypoint x="942" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RejectToFail_di" bpmnElement="Flow_RejectToFail">
        <di:waypoint x="880" y="340" />
        <di:waypoint x="942" y="340" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
