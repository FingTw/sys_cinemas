                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            
            <staticText>
                <reportElement x="20" y="0" width="300" height="35" forecolor="#FFFFFF" uuid="f1b16ade-9220-4e3d-8353-00187da06422"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="24" isBold="true"/>
                </textElement>
                <text><![CDATA[SYS CINEMA]]></text>
            </staticText>
            
            <textField>
                <reportElement x="20" y="40" width="400" height="25" forecolor="#FECACA" uuid="1e048548-9a36-4d3a-8656-89ee06574ff5"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{ReportTitle}]]></textFieldExpression>
            </textField>
            
            <textField pattern="dd/MM/yyyy HH:mm:ss">
                <reportElement x="400" y="0" width="155" height="20" forecolor="#FECACA" uuid="d8fb48a5-4a03-42aa-9709-6ce834022cbc"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="400" y="20" width="155" height="20" forecolor="#FECACA" uuid="e8fec870-2b5b-440d-b55c-02f293a5e562"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Người lập: " + $P{GeneratedBy}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    
