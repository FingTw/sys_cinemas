<?xml version="1.0" encoding="UTF-8"?>
<!-- Cinema scheduling Service Log4j2 Config - SERVICE_NAME duoc set qua system property -->
<Configuration status="WARN" monitorInterval="30">

    <Properties>
        <Property name="SERVICE_NAME">CINEMA-SCHEDULING</Property>
        <!-- Pattern cho Console (co mau sac + OTel trace) -->
        <Property name="CONSOLE_PATTERN">%style{%d{HH:mm:ss}}{white} %highlight{%-5level}{FATAL=red blink, ERROR=red, WARN=yellow, INFO=bright_blue, DEBUG=green, TRACE=blue} %style{[%X{requestId}]}{bright_yellow} %style{[%style{CINEMA-SCHEDULING}{bright_white}]}{bright_blue} %style{%logger{1.}}{bright_green} : %msg%n%throwable</Property>
        <Property name="FILE_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [CINEMA-SCHEDULING] [%X{requestId}]%notEmpty{ [%X{responseTime}]}%notEmpty{ [traceId=%X{traceId}, spanId=%X{spanId}]} %logger{50} : %msg%n</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${CONSOLE_PATTERN}" charset="UTF-8" disableAnsi="false"/>
        </Console>
        <RollingFile name="File"
                     fileName="logs/cinema-scheduling.log"
                     filePattern="logs/cinema-scheduling.%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${FILE_PATTERN}" charset="UTF-8"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="50MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30">
                <Delete basePath="logs" maxDepth="1">
                    <IfFileName glob="cinema-scheduling.*.log.gz"/>
                    <IfLastModified age="30d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Logger name="org.springframework" level="WARN" additivity="false">
            <AppenderRef ref="Console"/><AppenderRef ref="File"/>
        </Logger>
        <Logger name="org.hibernate" level="WARN" additivity="false">
            <AppenderRef ref="Console"/><AppenderRef ref="File"/>
        </Logger>
        <Logger name="org.apache" level="WARN" additivity="false">
            <AppenderRef ref="Console"/><AppenderRef ref="File"/>
        </Logger>
        <Logger name="io.lettuce" level="WARN" additivity="false">
            <AppenderRef ref="Console"/><AppenderRef ref="File"/>
        </Logger>
        <Logger name="io.netty" level="WARN" additivity="false">
            <AppenderRef ref="Console"/><AppenderRef ref="File"/>
        </Logger>
        <Logger name="org.flywaydb" level="INFO" additivity="false">
            <AppenderRef ref="Console"/><AppenderRef ref="File"/>
        </Logger>
        <Logger name="com.example.cinema.common.logging" level="INFO" additivity="false">
            <AppenderRef ref="Console"/><AppenderRef ref="File"/>
        </Logger>
        <Logger name="com.example.cinema" level="INFO" additivity="false">
            <AppenderRef ref="Console"/><AppenderRef ref="File"/>
        </Logger>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>
</Configuration>


