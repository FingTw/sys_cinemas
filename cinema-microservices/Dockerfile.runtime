FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

ARG MODULE_NAME

# Download OpenTelemetry Java Agent
ARG OTEL_AGENT_VERSION=2.11.0
ADD https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v${OTEL_AGENT_VERSION}/opentelemetry-javaagent.jar /app/opentelemetry-javaagent.jar

COPY ${MODULE_NAME}/target/*.jar app.jar

# Default: OTel agent DISABLED (set OTEL_JAVAAGENT_ENABLED=true to enable)
ENV JAVA_OPTS="-Xms256m -Xmx512m"
ENV OTEL_JAVAAGENT_ENABLED="false"
ENV OTEL_SERVICE_NAME=""
ENV OTEL_EXPORTER_OTLP_ENDPOINT=""
ENV OTEL_METRICS_EXPORTER="none"
ENV OTEL_LOGS_EXPORTER="none"
ENV OTEL_TRACES_EXPORTER="otlp"

ENTRYPOINT ["sh", "-c", "\
  if [ \"$OTEL_JAVAAGENT_ENABLED\" = \"true\" ]; then \
    java $JAVA_OPTS -javaagent:/app/opentelemetry-javaagent.jar -jar app.jar; \
  else \
    java $JAVA_OPTS -jar app.jar; \
  fi"]
